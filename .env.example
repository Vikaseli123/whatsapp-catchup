# Required when using OpenRouter. Copy this file to .env for local development.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Use a long random value in production.
FLASK_SECRET_KEY=

# Optional: set this to a Render Persistent Disk location.
# DATABASE_PATH=/var/data/catchup.sqlite3
